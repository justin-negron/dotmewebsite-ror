# Copy to terraform.tfvars (gitignored) and fill in.
aws_region         = "us-east-1"
domain_name        = "justinnegron.dev"
site_bucket_name   = "justinnegron-dev-site"
assets_bucket_name = "justinnegron-dev-assets"
environment        = "production"

# Lightsail origin
ssh_allowed_ip       = "203.0.113.10"                 # your public IP
admin_ssh_public_key = "ssh-ed25519 AAAA... you@host" # contents of ~/.ssh/id_ed25519.pub
contact_notify_to    = "you@example.com"              # receives contact form notifications
