# Development environment (copy to .env). Production values live in AWS SSM
# Parameter Store under /justinnegron/prod/ and are written to the server at deploy time.

# Database (matches backend/docker-compose.yml)
DB_USERNAME=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:password123@localhost:5432/portfolio_development

# JWT signing secret (generate with: bin/rails secret)
JWT_SECRET=

# Admin user created by db/seeds.rb (password required, min 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Frontend origin for CORS and mail links
FRONTEND_URL=http://localhost:5173

# Contact notifications (development delivers through SMTP below)
MAILER_FROM=notifications@justinnegron.dev
CONTACT_NOTIFY_TO=
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Image uploads (optional in development)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# ASSETS_HOST=assets.justinnegron.dev
